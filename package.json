{
  "name": "termous",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.18.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "imports": {
    "#app/*": "./src/app/*/index.ts",
    "#pages/*": "./src/pages/*/index.ts",
    "#widgets/*": "./src/widgets/*/index.ts",
    "#features/*": "./src/features/*/index.ts",
    "#entities/*": "./src/entities/*/index.ts",
    "#shared/*": "./src/shared/*/index.ts",
    "#common/*": "./common/*/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && pnpm run build:renderer && pnpm run build:package",
    "build:package": "pnpm run build:skills && node scripts/ci/build-local-package.mjs",
    "build:package:validation": "pnpm run build:skills && node scripts/ci/build-local-package.mjs --version 0.0.0 --output ../build/update-validation",
    "build:renderer": "pnpm run build:skills && vite build",
    "build:skills": "node scripts/agent/build-skills-bundle.mjs",
    "build:update-simulation": "node scripts/update-simulation/build-fixtures.mjs",
    "build:validation": "pnpm run typecheck && pnpm run build:renderer && pnpm run build:package:validation",
    "check:architecture": "node scripts/architecture/check.mjs",
    "lint": "pnpm run lint:code && pnpm run lint:styles && pnpm run check:architecture",
    "lint:code": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:styles": "node scripts/styles/check.mjs && stylelint \"src/**/*.scss\" --allow-empty-input",
    "preview": "vite preview",
    "test": "pnpm run test:node && pnpm run test:ui",
    "test:node": "node --test \"src/**/*.test.ts\" \"electron/**/*.test.ts\" \"common/**/*.test.ts\" \"scripts/architecture/**/*.test.mjs\" \"scripts/ci/**/*.test.mjs\" \"scripts/styles/**/*.test.mjs\" \"scripts/update-simulation/**/*.test.mjs\"",
    "test:ui": "vitest run",
    "test:release": "node --test \"scripts/ci/**/*.test.mjs\"",
    "test:update-simulation": "node --test \"scripts/update-simulation/**/*.test.mjs\"",
    "test:update-simulation:acceptance": "pnpm run build:update-simulation && node scripts/update-simulation/run-acceptance.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@earendil-works/pi-agent-core": "0.84.3",
    "@earendil-works/pi-ai": "0.84.3",
    "@modelcontextprotocol/client": "2.0.0",
    "@novnc/novnc": "1.7.0",
    "@uiw/codemirror-theme-vscode": "^4.25.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "antd": "^6.5.1",
    "builder-util-runtime": "9.7.0",
    "codemirror": "^6.0.2",
    "dayjs": "^1.11.21",
    "echarts": "^6.1.0",
    "electron-updater": "6.8.9",
    "i18next": "^26.3.6",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.9",
    "react-resizable-panels": "^4.12.2",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.0.1",
    "postcss-selector-parser": "^7.1.4",
    "sass": "^1.102.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.10",
    "yaml": "2.9.0"
  },
  "main": "dist-electron/main.js"
}
